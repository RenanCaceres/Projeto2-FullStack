# Porta de execução da API
PORT=3001

# String de conexão com o banco de dados (PostgreSQL / MySQL)
DATABASE_URL=postgres://usuario:senha@localhost:5432/finanflow_db

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET=seu_segredo_super_seguro_jwt_2026

# Tempo de expiração do token JWT (ex.: 1h, 8h, 1d)
JWT_EXPIRES_IN=1h

# URL permitida para comunicação via CORS (Front-End)
FRONTEND_URL=http://localhost:5173
